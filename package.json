{
  "name": "neus",
  "version": "0.13.0",
  "description": "Serverless personal information hub. Local-first, encryption-ready, plugin-extensible.",
  "type": "module",
  "license": "MIT",
  "author": "shizukutanaka",
  "homepage": "https://github.com/shizukutanaka/neus",
  "repository": {
    "type": "git",
    "url": "https://github.com/shizukutanaka/neus.git"
  },
  "scripts": {
    "dev": "python3 -m http.server 8080",
    "lint": "node --check _worker.js && node --check sw.js && echo 'lint: OK'",
    "lint:html": "node scripts/check-html.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run build:csp && npm run lint && npm run lint:html",
    "deploy:worker": "wrangler deploy",
    "deploy:pages": "wrangler pages deploy . --project-name=neus",
    "deploy": "npm run deploy:pages && npm run deploy:worker",
    "build:csp": "node scripts/compute-csp-hash.mjs",
    "prerelease": "npm run build:csp && npm run lint && npm run lint:html && npm test",
    "release:check": "node scripts/release.mjs",
    "release": "node scripts/release.mjs --tag=v0.13.0",
    "lighthouse:local": "node scripts/lighthouse-local.mjs",
    "sbom": "node scripts/sbom.mjs",
    "contrast": "node scripts/contrast-check.mjs",
    "audit:a11y": "vitest run tests/axe-a11y.test.mjs",
    "test:browser": "playwright test --config playwright.config.mjs",
    "test:offline": "playwright test --config playwright.config.mjs browser-offline",
    "test:perf": "playwright test --config playwright.config.mjs browser-perf"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@vitest/coverage-v8": "^4.1.6",
    "axe-core": "^4.11.4",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.6",
    "wrangler": "^4.93.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "ws": "^8.20.1"
  }
}
